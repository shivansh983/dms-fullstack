{
  "name": "dms_server",
  "version": "1.0.0",
  "description": "DMS backend server",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:setup": "npm run db:migrate && npm run seed",
    "db:reset": "sequelize-cli db:migrate:undo:all && npm run db:migrate && npm run seed",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:auth": "node scripts/test-auth-flows.js",
    "rustfs:inspect": "node scripts/rustfs-inspect.js",
    "verify:storage": "node scripts/verify-storage.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "file-type": "^21.3.4",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "resend": "^6.19.0",
    "sequelize": "^6.37.8",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
