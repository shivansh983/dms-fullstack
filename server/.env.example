NODE_ENV=development
PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dms
DB_USER=postgres
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads
UPLOAD_CHUNK_MB=5
MAX_FILE_GB=2
STORAGE_QUOTA_GB=5
UPLOAD_TTL_HOURS=24

S3_ENDPOINT=http://localhost:9010
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dms-documents
S3_URL_TTL=300

GOOGLE_CLIENT_ID=

APP_URL=http://localhost:8000
PASSWORD_RESET_LINK_BASE=dmsapp://reset-password
PASSWORD_RESET_TTL_MIN=15

RESEND_API_KEY=
EMAIL_FROM=DMS <onboarding@resend.dev>
